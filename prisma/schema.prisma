generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model projects {
  projectId   BigInt        @id @default(autoincrement())
  name        String        @db.VarChar(200)
  category    String?       @db.VarChar(100)
  description String?
  area        Int?
  location    String?       @db.VarChar(255)
  type        String?       @db.VarChar(100)
  photo       String?       @db.VarChar(200)
  year        Int?
  slug        String?       @unique @db.VarChar(200)
  blogUrl     String?
  published   Boolean       @default(false)
  images      images[]      @relation("ProjectImages")
  images_webp images_webp[]

  @@index([published], map: "idx_projects_published")
}

model images {
  imageId     BigInt   @id @default(autoincrement())
  projectId   BigInt
  path        String
  width       Int?
  height      Int?
  no          Int?
  isLandCover Boolean  @default(false)
  isPortCover Boolean  @default(false)
  mime        String?  @db.VarChar(50)
  alt         String?  @db.VarChar(255)
  projects    projects @relation("ProjectImages", fields: [projectId], references: [projectId], onDelete: Cascade)

  @@index([projectId], map: "idx_images_projectid")
}

model images_webp {
  imageId     BigInt   @id @default(autoincrement())
  projectId   BigInt
  path        String
  width       Int?
  height      Int?
  no          Int?
  isLandCover Boolean  @default(false)
  isPortCover Boolean  @default(false)
  mime        String?  @db.VarChar(50)
  alt         String?  @db.VarChar(255)
  projects    projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "images_webp_projectid_fkey")

  @@index([projectId], map: "idx_images_webp_projectid")
}
